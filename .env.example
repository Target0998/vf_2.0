# Másold .env-be: cp .env.example .env
GHOST_URL=http://localhost:2368
MYSQL_ROOT_PASSWORD=vfroot
MYSQL_PASSWORD=ghostpass

# Stripe TESZT kulcs (sk_test_…). Üresen az adomány API mock módban fut.
STRIPE_SECRET_KEY=

# Támogatói nyilvántartás (donate-api/donors.js): Stripe webhook → Ghost tag.
# Stripe Dashboard → Developers → Webhooks → végpont: https://<domain>/api/donate/webhook,
# események: checkout.session.completed, checkout.session.async_payment_succeeded → aláíró titok (whsec_…).
# Helyben bármilyen szöveg jó (scripts/webhook-test.mjs ezzel ír alá).
STRIPE_WEBHOOK_SECRET=
# Ghost Admin → Settings → Integrations → "Donate API" → Admin API key (helyben: npm run seed kiírja)
GHOST_ADMIN_API_KEY=

# Futás élő térkép (donate-api/track.js). TRACK_TOKEN = hosszú véletlen szöveg (openssl rand -hex 16),
# ugyanez a telefonon a Traccar Client „Device identifier” mezőjébe. Üresen a követés ki van kapcsolva.
TRACK_TOKEN=
# Helyi teszthez: TRACK_START= (üres) → a mai próbapontok is látszanak; TRACK_DELAY_MIN=0 → késleltetés nélkül
# TRACK_START=2026-10-16T00:00:00+02:00
# TRACK_DELAY_MIN=5

# Adományok listája a szervezőknek: https://<domain>/api/donate/admin/ (donate-api/admin.js).
# Hosszú jelszó (openssl rand -base64 18); a böngésző kéri, a felhasználónév bármi lehet. Üresen ki van kapcsolva.
ADMIN_PASSWORD=
# Ehhez a listához külön Stripe-kulcs (nem kötelező). Stagingen ide jöhet egy csak olvasó ÉLES kulcs (rk_live_…),
# így a staging adománydoboza marad a teszt kulcson. Üresen a STRIPE_SECRET_KEY-t használja.
STRIPE_READ_KEY=

# A seed script által létrehozott admin fiók
GHOST_ADMIN_EMAIL=admin@vilagitanifogok.local
GHOST_ADMIN_PASSWORD=Vilagitani-Fogok-2026

# ── Csak szerveren (docker-compose.prod.yml) ──────────────────────────────
# GHOST_URL=https://staging.vilagitanifogok.hu
# SITE_DOMAIN=staging.vilagitanifogok.hu
# MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD: erős, véletlen jelszavak (openssl rand -base64 24)
#
# Mailgun → Sending → Domain settings → SMTP credentials
# MAILGUN_SMTP_HOST=smtp.eu.mailgun.org      # US régió: smtp.mailgun.org
# MAILGUN_SMTP_USER=postmaster@mg.vilagitanifogok.hu
# MAILGUN_SMTP_PASSWORD=
# MAIL_FROM="Világítani Fogok <noreply@vilagitanifogok.hu>"
#
# Webanalitika (Tinybird felhő, EU – Frankfurt). Lépések: docs/PROJECT.md → Web analytics.
# Bekapcsolás: COMPOSE_PROFILES=analytics, és a get-tokens kimenete ide:
# COMPOSE_PROFILES=analytics
# TINYBIRD_API_URL=https://api.tinybird.co
# TINYBIRD_WORKSPACE_ID=
# TINYBIRD_ADMIN_TOKEN=
# TINYBIRD_TRACKER_TOKEN=
