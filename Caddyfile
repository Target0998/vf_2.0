# Used by docker-compose.prod.yml. Caddy fetches the Let's Encrypt certificate automatically
# (the domain's A record must point at this server and ports 80/443 must be open).
{$SITE_DOMAIN} {
	encode zstd gzip

	# donate API on the same origin → no extra DNS record, no CORS preflight
	# theme setting donate_api_url = https://<domain>/api/donate/checkout
	handle_path /api/donate/* {
		reverse_proxy donate-api:8787
	}

	# web analytics: Ghost's tracker posts to /.ghost/analytics/… → traffic-analytics (profile "analytics")
	@analytics path_regexp analytics_match ^(.*)/\.ghost/analytics(.*)$
	handle @analytics {
		rewrite * {re.analytics_match.2}
		reverse_proxy traffic-analytics:3000
	}

	# old Mobirise URLs → new pages
	redir /index.html / permanent
	redir /rolunk.html /rolunk/ permanent
	redir /tevekenyseg.html /tevekenysegunk/ permanent
	redir /atlathatosag.html /atlathatosag/ permanent
	redir /top.html /top-plusz/ permanent
	redir /assets/files/* /atlathatosag/   # old PDF links; the documents now live in Ghost
	# internal staff tool (Google Apps Script), same target as the old site
	redir /gyerekek* https://script.google.com/a/macros/vilagitanifogok.hu/s/AKfycby6ahrHFbhFSuXv0PMJTZHbrm7vvNHteUyIzjt5FPr6yHPLRG0ucQUNXvTJT3XT1r-Y/exec

	handle {
		reverse_proxy ghost:2368
	}
}

# www → bare domain (needs a DNS record for www too)
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
