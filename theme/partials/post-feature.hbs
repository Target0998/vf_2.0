{{!-- Kiemelt bejegyzés a Napló tetején --}}
<a class="post-feature" href="{{url}}">
    {{#if feature_image}}{{> "feature-img" class="post-feature-img" sizes="(max-width: 1100px) 100vw, 760px" eager=true}}{{else}}<span class="post-feature-img photo-empty" aria-hidden="true"></span>{{/if}}
    <span class="post-feature-body">
        {{> "post-meta"}}
        <span class="post-feature-title">{{title}}</span>
        {{#if custom_excerpt}}<span class="post-feature-excerpt">{{custom_excerpt}}</span>{{else}}<span class="post-feature-excerpt">{{excerpt words="30"}}</span>{{/if}}
        <span class="link-arrow">Tovább olvasom →</span>
    </span>
</a>
