{{!-- Responsive feature image of the current post/page. Params: class, sizes, eager --}}
{{#if feature_image}}
<img class="{{class}}"
    srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1800w"
    sizes="{{#if sizes}}{{sizes}}{{else}}100vw{{/if}}"
    src="{{img_url feature_image size="l"}}"
    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
    {{#unless eager}}loading="lazy"{{/unless}}>
{{/if}}
